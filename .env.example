# Copy to .env and adjust. Read by docker-compose.yml.

# --- ports (host side) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- frontend ---
# Base URL the SPA calls for API requests.
VITE_API_URL=http://localhost:8000

# --- backend: museum provider API keys ---
# Not wired up yet (see STEERING.md's "known risks" — Smithsonian DEMO_KEY
# is throttled to ~30 req/hr/IP; a free api.data.gov key lifts that to
# 1000/hr). Uncomment and fill in once the adapters read them.
# SMITHSONIAN_API_KEY=
# MET_API_KEY=
# HARVARD_API_KEY=

# --- backend: database ---
# Not wired up yet — SQLAlchemy/Alembic are installed but no DB service is
# in docker-compose.yml yet. Add one (e.g. postgres) plus this var when
# persistence lands.
# DATABASE_URL=
