# Copy to .env and adjust. Read by docker-compose.yml.

# --- ports (host side) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- frontend ---
# Base URL the SPA calls for API requests.
VITE_API_URL=http://localhost:8000

# --- backend: museum provider API keys ---
# Met, AIC, Cleveland, Rijksmuseum, and V&A need no key. Smithsonian works
# with the shared DEMO_KEY (~30 req/hr/IP) if left unset; a free
# api.data.gov key raises that to 1000/hr: https://api.data.gov/signup/
# SMITHSONIAN_API_KEY=
# Harvard requires a free non-commercial signup key:
# https://harvardartmuseums.org/collections/api
HARVARD_API_KEY=

# --- backend: database ---
# Not wired up yet — SQLAlchemy/Alembic are installed but no DB service is
# in docker-compose.yml yet. Add one (e.g. postgres) plus this var when
# persistence lands.
# DATABASE_URL=
